{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js + Browser specific
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "incremental": true,
    
    // Path aliases
    "paths": {
      "@/*": ["./src/*"],
      "@sip/shared-types": ["../../packages/shared-types/src/index.ts"]
    },
    
    // Next.js plugin
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}