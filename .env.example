# =============================================================================
# smart-internship-platform — Environment Variables
# Xem tech stack đầy đủ: docs/01-project/PROJECT_OVERVIEW.md
#
# Bước thiết lập:
#   1. cp .env.example .env
#   2. Điền DATABASE_URL từ Neon.tech (Phase 1 sẽ dùng qua Prisma)
#   3. Điền REDIS_URL từ Redis Cloud (Phase 2)
#   4. Điền RESEND_API_KEY / CLOUDINARY_* khi cần dùng thật (dev có thể để trống)
# =============================================================================

# ──────────────────────────────────────────────
# App (apps/server)
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ──────────────────────────────────────────────
# Database — Neon PostgreSQL (Prisma, Phase 1)
# Đăng ký: https://neon.tech → Create Project → copy connection string
# ──────────────────────────────────────────────
DATABASE_URL=
# Chỉ có giá trị yes hoặc no. Lưu ý: Cẩn trọng khi sử dụng
CONFIRM_CLEAR_DATA=

# ──────────────────────────────────────────────
# Redis — Redis Cloud (Phase 2: rate-limit OTP, JWT blacklist, cache)
# ──────────────────────────────────────────────
REDIS_URL=

# ──────────────────────────────────────────────
# JWT (Phase 2 — Identity & Access)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────
# OTP (Phase 2)
# Dev: OTP cố định, không gửi email thật
# ──────────────────────────────────────────────
OTP_HARDCODE=true
OTP_HARDCODE_VALUE=123456

# ──────────────────────────────────────────────
# Email — Resend (Phase 2/9: OTP, thông báo giao dịch)
# ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# DEV ONLY: không gửi email thật, chỉ in nội dung ra console server (tiện khi
# đăng ký thử bằng email giả). BẮT BUỘC false khi triển khai — server từ chối
# khởi động nếu NODE_ENV=production và giá trị này là true.
DEV_SKIP_EMAIL_SENDING=false

# ──────────────────────────────────────────────
# Google OAuth (Phase 2 — chỉ đăng ký/đăng nhập Candidate/Employer, KHÔNG áp dụng Admin)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# JobPost Skill — Hướng B (AD-9): khử trùng lặp kỹ năng người dùng tự nhập.
# Cả 4 biến đều optional. Thiếu GEMINI_API_KEY thì cron bỏ qua bước xác nhận
# bằng LLM, kỹ năng vùng xám nằm chờ Admin duyệt tay — hệ thống vẫn chạy đúng.
# ──────────────────────────────────────────────
GEMINI_API_KEY=
# Google gỡ model cũ theo thời gian (gemini-2.0-flash đã bị gỡ) — đổi ở đây,
# không phải sửa code. Phải có giá trị, không để trống.
GEMINI_MODEL=gemini-3.6-flash

# Đường dẫn lưu model embedding local (@huggingface/transformers) — nên trỏ ra
# ổ đĩa khác với thư mục dự án để tránh phình dung lượng repo cục bộ (model
# quantized ~465MB). Bỏ trống thì model nằm trong node_modules.
EMBEDDING_MODEL_CACHE_DIR=
# Đổi model thì phải đổi cả kiểu cột Skill.embedding trong schema.prisma cho
# khớp số chiều, kèm migration. Phải có giá trị, không để trống.
EMBEDDING_MODEL_ID=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# ──────────────────────────────────────────────
# Trích xuất CV bằng AI (docs/06-backend/cv-ai-extraction-phase1/PLAN.md).
# Thứ tự tầng: GEMINI_MODEL → GEMINI_FALLBACK_MODEL (cùng GEMINI_API_KEY) →
# OpenRouter → Tesseract (OCR offline, chỉ cho ảnh). Tất cả đều optional.
# ──────────────────────────────────────────────
# Model Gemini thứ 2 khi model chính báo 503 "high demand". Để trống = tắt tầng này.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,qwen/qwen3.8-27b:free
# Nơi cache traineddata của tesseract.js (vie+eng, ~30MB) — nên trỏ ra ổ khác,
# vd. D:\ai-models-cache\smart-internship-platform\tesseract
TESSERACT_CACHE_DIR=

# ──────────────────────────────────────────────
# Admin bootstrap script (apps/server/scripts/create-admin.ts)
# Không phải biến runtime của server — chỉ dùng khi chạy `npm run create-admin`.
# Admin KHÔNG có luồng đăng ký; đây là cách duy nhất tạo tài khoản Admin.
# ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ──────────────────────────────────────────────
# Media storage — Cloudinary (avatar, logo, CV, banner)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ──────────────────────────────────────────────
# Phase 4 — Employer & Company verification
# ──────────────────────────────────────────────
# Đuôi email phổ biến (cá nhân) — nếu email đăng ký công ty thuộc list này thì
# luôn yêu cầu xác thực thủ công bởi Admin (kèm giấy phép kinh doanh), bỏ qua
# tra cứu mã số thuế. Phân cách bằng dấu phẩy.
COMMON_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com,live.com,aol.com,protonmail.com

# API tra cứu thông tin doanh nghiệp theo mã số thuế (VietQR) — dùng để so
# khớp đuôi email công ty với shortName doanh nghiệp.
VIETQR_API_URL=https://api.vietqr.io/v2/business

# DEV ONLY: bỏ qua hàng đợi xác thực thủ công của Admin, tự động verify mọi
# công ty cần review (kể cả trường hợp lẽ ra cần Admin duyệt tay).
# BẮT BUỘC đặt false khi triển khai thực tế — server sẽ TỪ CHỐI KHỞI ĐỘNG nếu
# NODE_ENV=production và giá trị này là true (xem shared/config/env.ts).
DEV_SKIP_COMPANY_MANUAL_VERIFICATION=false

# ──────────────────────────────────────────────
# Phase 5 — Subscription & Payment (VNPay/Momo sandbox)
# Xem ARCHITECTURE_DECISIONS.md AD-6 và docs/06-backend/phase-05-subscription-payment/PLAN.md.
# Credentials sandbox thật KHÔNG commit vào file này — điền trực tiếp vào .env cục bộ.
# ──────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/employer/subscription/return/vnpay

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/employer/subscription/return/momo
# Bắt buộc là URL public lúc test IPN thật — dùng VS Code port forwarding
# (tab "PORTS" trong terminal tích hợp -> forward port 4000 -> Port Visibility
# "Public" -> copy URL "https://<id>-4000.<region>.devtunnels.ms") rồi nối
# "/api/payments/momo/ipn". Đổi mỗi lần tạo lại tunnel.
MOMO_IPN_URL=http://localhost:4000/api/payments/momo/ipn
MOMO_REQUEST_TYPE=payWithATM

# DEV ONLY: bỏ qua việc gọi cổng thanh toán VNPay/Momo thật khi checkout —
# đánh dấu thanh toán COMPLETED và kích hoạt gói ngay lập tức, dùng khi sandbox
# VNPay/Momo không dùng được nhưng vẫn cần test các phần phụ thuộc subscription.
# BẮT BUỘC đặt false khi triển khai thực tế — server sẽ TỪ CHỐI KHỞI ĐỘNG nếu
# NODE_ENV=production và giá trị này là true (xem shared/config/env.ts).
DEV_SKIP_PAYMENT_GATEWAY=false

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────
# Web (apps/web) — gọi API qua Nginx gateway (single entry point, xem infra/nginx/nginx.conf)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Google Identity Services (nút "Đăng nhập với Google" phía client) — cùng project
# với GOOGLE_CLIENT_ID ở trên, chỉ khác đây là biến public (Phase 2 frontend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=