# =============================================================================
# smart-internship-platform — Environment Variables
# Xem tech stack đầy đủ: docs/01-project/PROJECT_OVERVIEW.md
#
# Bước thiết lập:
#   1. cp .env.example .env
#   2. Điền DATABASE_URL từ Neon.tech (Phase 1 sẽ dùng qua Prisma)
#   3. Điền REDIS_URL từ Redis Cloud (Phase 2)
#   4. Điền RESEND_API_KEY / CLOUDINARY_* khi cần dùng thật (dev có thể để trống)
# =============================================================================

# ──────────────────────────────────────────────
# App (apps/server)
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ──────────────────────────────────────────────
# Database — Neon PostgreSQL (Prisma, Phase 1)
# Đăng ký: https://neon.tech → Create Project → copy connection string
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# Redis — Redis Cloud (Phase 2: rate-limit OTP, JWT blacklist, cache)
# ──────────────────────────────────────────────
REDIS_URL=

# ──────────────────────────────────────────────
# JWT (Phase 2 — Identity & Access)
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────
# OTP (Phase 2)
# Dev: OTP cố định, không gửi email thật
# ──────────────────────────────────────────────
OTP_HARDCODE=true
OTP_HARDCODE_VALUE=123456

# ──────────────────────────────────────────────
# Email — Resend (Phase 2/9: OTP, thông báo giao dịch)
# ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ──────────────────────────────────────────────
# Google OAuth (Phase 2 — chỉ đăng ký/đăng nhập Candidate/Employer, KHÔNG áp dụng Admin)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Admin bootstrap script (apps/server/scripts/create-admin.ts)
# Không phải biến runtime của server — chỉ dùng khi chạy `npm run create-admin`.
# Admin KHÔNG có luồng đăng ký; đây là cách duy nhất tạo tài khoản Admin.
# ──────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ──────────────────────────────────────────────
# Media storage — Cloudinary (avatar, logo, CV, banner)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────
# Web (apps/web) — gọi API qua Nginx gateway (single entry point, xem infra/nginx/nginx.conf)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Google Identity Services (nút "Đăng nhập với Google" phía client) — cùng project
# với GOOGLE_CLIENT_ID ở trên, chỉ khác đây là biến public (Phase 2 frontend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
