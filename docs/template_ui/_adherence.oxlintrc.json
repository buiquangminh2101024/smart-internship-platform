        "selector": "JSXOpeningElement[name.name='JobCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:draft|review|published|closed|expired|takendown)$/]",
        "message": "<JobCard> status must be one of 'draft' | 'review' | 'published' | 'closed' | 'expired' | 'takendown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|onChange|summary|style|key|ref|className|style|children)$/]",
